{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Flask Server (Port 5001)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/app.py",
      "python": "${workspaceFolder}/venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PORT": "5001",
        "FLASK_ENV": "development"
      },
      "console": "integratedTerminal"
    }
  ]
}
