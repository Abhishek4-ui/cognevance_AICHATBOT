# Server Configuration
PORT=5000
FLASK_ENV=development
DEBUG=True
SECRET_KEY=replace_with_strong_secret_key_in_production
JWT_SECRET_KEY=replace_with_strong_jwt_secret_key_in_production
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# MongoDB Connection (Local or Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.0juuoy6.mongodb.net/neurochat_db?retryWrites=true&w=majority
# Fallback local URI: mongodb://localhost:27017/neurochat_db

# Generative AI APIs
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
DEFAULT_LLM_PROVIDER=groq

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin Initial Credentials
ADMIN_EMAIL=admin@neurochat.ai
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin
